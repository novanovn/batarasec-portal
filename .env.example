# Application
NODE_ENV=development
PORT=4000
PORTAL_URL=http://localhost:4000

# Database
POSTGRES_USER=batarasec_portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=batarasec_portal
DATABASE_URL=postgres://batarasec_portal:change-me@localhost:5433/batarasec_portal

# Valkey
VALKEY_URL=redis://localhost:6380

# Admin auth
JWT_ACCESS_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-a-different-strong-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false

# License signing
LICENSE_SIGNING_SECRET=generate-a-license-signing-secret

# Settings encryption
SETTINGS_ENCRYPTION_KEY=generate-32-byte-base64-key

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=license@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="BataraSec <license@example.com>"
SMTP_DRY_RUN=false
